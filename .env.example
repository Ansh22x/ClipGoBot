# Telegram Bot API Token obtained from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Comma-separated Telegram User IDs who have administrator privileges
ADMIN_IDS=123456789,987654321

# SQLite database file path
DB_PATH=data/bot.db

# Directory for temporary downloaded media
DOWNLOAD_DIR=downloads

# Concurrency & Performance settings
MAX_CONCURRENT_DOWNLOADS=5
TELEGRAM_UPLOAD_LIMIT_MB=50
RATE_LIMIT_COOLDOWN_SEC=3

# User Quota Defaults
FREE_DAILY_QUOTA=5

# Binaries paths (optional, defaults to system PATH)
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg

# Logging
LOG_LEVEL=INFO
